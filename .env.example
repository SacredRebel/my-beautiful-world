# --- Mailchimp ---
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# --- Whop ---
# Developer tab -> Create Webhook -> copy the signing secret (starts with whsec_)
WHOP_WEBHOOK_SECRET=
# Optional: server-side API key, only needed for future API calls
WHOP_API_KEY=

# --- Pinterest Conversions API ---
# Ads -> Conversions -> Conversion access token. Never commit this: the repo is public.
PINTEREST_CONVERSIONS_TOKEN=
# Optional. Defaults to 549770624334 (Eden Education) if unset.
PINTEREST_AD_ACCOUNT_ID=
